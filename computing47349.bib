@article{cremona_minimisation_2010,
	title = {Minimisation and reduction of 2-, 3- and 4-coverings of elliptic curves},
	volume = {4},
	issn = {1944-7833, 1937-0652},
	url = {http://arxiv.org/abs/0908.1741},
	doi = {10.2140/ant.2010.4.763},
	abstract = {In this paper we consider models for genus one curves of degree n for n = 2, 3 and 4, which arise in explicit n-descent on elliptic curves. We prove theorems on the existence of minimal models with the same invariants as the minimal model of the Jacobian elliptic curve and provide simple algorithms for minimising a given model, valid over general number fields. Finally, for genus one models defined over Q, we develop a theory of reduction and again give explicit algorithms for n = 2, 3 and 4.},
	number = {6},
	urldate = {2023-12-28},
	journal = {Algebra \& Number Theory},
	author = {Cremona, John and Fisher, Tom and Stoll, Michael},
	month = sep,
	year = {2010},
	note = {arXiv:0908.1741 [math]},
	keywords = {11G05, 11G07, 14H52, Mathematics - Number Theory},
	pages = {763--820},
	annote = {Comment: 56 pages},
}

@article{balakrishnan_4-descent_2003,
	title = {4-descent on the elliptic curve y2=x{\textasciicircum}3+7823},
	abstract = {We outline the reﬁnement of the 4-descent used by Michael Stoll in [10] to ﬁnd the Mordell-Weil generator of the elliptic curve y2 ¢ x3 £ 7823. In general, given a 2-covering space of an elliptic curve, the procedure yields the set of everywhere locally soluble 4covering spaces lifting it.},
	language = {en},
	author = {Balakrishnan, Jennifer},
	year = {2003},
}

