    ];

    printf("Processing %d curves.\n", #Curves / 3);

    for (i = 1, #Curves / 3,
        arr = Curves[3*i - 2];
        s1  = Curves[3*i - 1];
        s2  = Curves[3*i];

        E = ellinit(arr);
        if (type(E) != "t_VEC", next);

        M1 = get_mat_4(s1, X);
        M2 = get_mat_4(s2, X);

        N = ellglobalred(E)[1];

        printf("\n--- Curve %d/20 (N = %d) ---\n", i, N);

        height = ellL1(E, 1) / ellbsd(E);
        printf("  height = %.6f  \n", height);

        gettime();
        P = ellheegner_4descent(E, M1, M2, height);
        t_heeg = gettime();

        printf("  ellheegner_4descent: %s  [%d ms]\n",
            if (P == -1, "FAIL", "OK"), t_heeg);

        if (P != -1,

            P1 = get_minimalmodel_point(M1, M2, P);

            if (ellisoncurve(E, P1),

                hp = ellheight(E, P1);
                printf("  generator found!  height = %.6f\n", hp);
            ,
                printf("  WARNING: point not on curve!\n");
            );

        ,
            printf("  No generator found!\n");
        );
