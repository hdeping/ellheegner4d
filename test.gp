map_cubic_point_to_4descent(E,M1,M2,P) = {
    my(S,s1,s2,X,y);
    y = 'y;
    X = [x1,x2,x3,x4];
    S = matdet(x*M1+M2);
    s1 = X*M1*X~;
    s2 = X*M2*X~;
    s3 = polresultant(s1,s2,x2);
    F = get_F1F2(M1,M2,X);
    s4 = get_tu(Vec(S),[x,y])[1] - P[1];
    s4 *= y^2;
    s5 = polresultant(s4,S-y^2,y);
    s5 = factor(s5)[1,1];
    
    my(X1);
    
    X1 = -polcoef(s5,0,x)/polcoef(s5,1,x);
    
    s6 = F[1]+F[2]*X1;
    
    s7 = polresultant(s1,s6,x2);
    s8 = polresultant(s3,s7,x3);
    [s1,s2,s7,s8] = subst([s1,s2,s7,s8],x1,1);
    s8 = factor(s8);
    s9 = s8[1,1];
    X4 = -polcoef(s9,0,x4)/polcoef(s9,1,x4);
    
    s7 = subst(s7,x4,X4);
    s7 = factor(s7)[1,1];
    X3 = -polcoef(s7,0,x3)/polcoef(s7,1,x3);
    
    [s1,s2] = substvec([s1,s2],[x3,x4],[X3,X4]);
    s1 = gcd([s1,s2]);
    X2 = -polcoef(s1,0,x2)/polcoef(s1,1,x2);

    X = [1,X2,X3,X4];
    X /= gcd(X);
    print([X2>0,X3>0,X4>0,log(vecmax(abs(X)))/log(10)]);
    
};
