show_gen(P,P1) = {
    my(p,r,q);
    \\print("The generator is ",P1);
    p = numerator(P1[1]);
    r = numerator(P1[2]);
    issquare(denominator(P1[1]),&q);
    print("$x_1=$",P[1]);
    print("$x_2=$",P[2]);
    print("$x_3=$",P[3]);
    print("$x_4=$",P[4]);
    print("$p=$",p);
    print("$q=$",q);
    print("$r=$",r);
};
