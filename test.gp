test24() = {
    my(E,s1,s2,X,M1,M2);
    E = ellinit([0, 0, 1, -2293, -42269]);
    s1 = x1^2 + 2*x1*x2 + x2^2 + 2*x2*x3 - x2*x4 + x3^2 - x3*x4 + 2*x4^2;
    s2 = x1*x2 + 3*x1*x3 + 2*x2^2 - x2*x3 - x2*x4 - 2*x3^2 + x4^2;
    X = [x1,x2,x3,x4];

    M1 = get_mat_4(s1,X);
    M2 = get_mat_4(s2,X);
    P = [
    11895237647566274750354012607048496, 
    -16688305732376878869468579641280673, 
    31414534455859483482080928309641508, 
    -2053072741250279100455041412022695
    ];
    F = get_F1F2(M1,M2,P);
    S = matdet(x*M1+M2);
    S = substvec(S,X,[1,1,1,1]);
    X1 = -F[1]/F[2];
    issquare(subst(S,x,X1),&Y1);
    print(S);

    P1 = get_tu(Vec(S),[X1,Y1]);
    IJ = get_IJ(Vec(S));
    e1 = ellinit([-27*IJ[1],-27*IJ[2]]);
    \\print(e1);
    
    for(n = 1,10, 
    pn = ellmul(e1,P1,2*n-1);
    \\print(pn);
    map_cubic_point_to_4descent(E,M1,M2,pn);
    );

};
